Global Integer EstatusCilindro, Check_Vacio, Zona3, error_vacioo

Function Estatus_Cilindro
	
	Do While (1)
				
		EstatusCilindro = In(0)
		
		'EstatusCilindro = 0, cilindro a dentro, cilindro b dentro
		'EstatusCilindro = 4, cilindro a dentro, cilindro b fuera
		'EstatusCilindro = 1, cilindro a fuera, cilindro b dentro
		'EstatusCilindro = 5, cilindro a fuera, cilindro b fuera	
		
	Loop
	
	
Fend


Function Estatus_Vacio
	
	Do While (1)
					
		If Check_Vacio = 1 Then
			If Sw(vacio_ok) = 0 Then
				If error_vacioo = 0 Then
					'CONEXION TCP/IP
					OpenNet #203 As Client
					WaitNet #203
					Print #203, "ERROR_insertion"
					Print "______________________________________"
					Print "VACIO NO OK Retirar Fusible y reintentar inserción"
					Print "______________________________________"
					Off cilindro
					Off vacio
	'				'zona = 1 significa dentro de la zona
	'				'zona = 0 significa fuera de la zona
	'				Box 3, -120, -90, 430, 450, 0, 0
	'				Zona3 = GetRobotInsideBox(3)
	'				If Zona3 = 1 Then
	'					Print("zona3")
	'					Tool 5
	'					SubirRobot_Z 'En SubirRobot_Z hay un Work_Speed
	'					Home_Speed
	'					Go home_l
	'					Off vacio
	'				EndIf
					
					On 544
					Off cilindro
					If fusible$ = "RELAY_132" Then
						error_vacioo = 1
					Else
							Pause
					EndIf
				EndIf
			EndIf
		EndIf
		
	Loop
	
	
Fend


