'Power High 'High,Low
	'Speed 30 'punto a punto (porcentaje) con Go
	'SpeedS 500 'Z (milimetros por segundo) con Move
	'SpeedR 90 'U (grados por segundo) rotaciones con Move "Punto" ROT
	
	'(porcentaje con el que acelera para llegar a la velocidad deseada)
	'(porcentaje con el que el robot ira desacelerando para llegar a,
	'detenerse, entre mas grande sea este numero mas brusco llegara al punto)
	'Accel 5, 5 'punto a punto 
	'AccelS 600, 600 'Z (milimetros por s cuadrado)
	'AccelR 90, 90 'U (grados por s cuadrado)
	
Function Home_Speed
	Power High;
	Speed 80;				Accel 50, 50;
	SpeedS 400;				AccelS 400, 300;
	SpeedR 80;				AccelR 80, 80;
	'Low_Speed
Fend

Function Work_Speed
	Power High;
	Speed 100;				Accel 90, 90;
	SpeedS 1800;			AccelS 10000, 10000;
	SpeedR 150;				AccelR 150, 150;
	
	If DerIzq = 1 Then 'Si el fusible esta del lado derecho, cambia velocidad (para proteger transmision del robot)
		Speed 70;				Accel 50, 50;
	EndIf
	If fusible$ = "RELAY_132" Or fusible$ = "RELAY_112" Or fusible$ = "MAXI_50" Or fusible$ = "MAXI_40" Or fusible$ = "MAXI_30" Then
		Speed 70;				Accel 50, 50;
		SpeedR 30;				AccelR 30, 30;
	EndIf
	'Low_Speed
Fend

Function Low_Speed
	Power High;
	Speed 35;				Accel 35, 35;
	SpeedS 400;				AccelS 400, 400;
	SpeedR 50;				AccelR 70, 70;
	
	If fusible$ = "RELAY_132" Or fusible$ = "RELAY_112" Then
		Power High;
		Speed 30;			Accel 30, 35;
		SpeedS 300;			AccelS 300, 300;
		SpeedR 30;			AccelR 30, 30;
	ElseIf fusible$ = "MAXI_50" Or fusible$ = "MAXI_40" Or fusible$ = "MAXI_30" Then
		Power High;
		Speed 30;			Accel 30, 35;
		SpeedS 320;			AccelS 320, 320;
		SpeedR 40;			AccelR 40, 40;
	EndIf
Fend

Function Extra_Low_Speed
	Power High;
	Speed 20;			Accel 20, 20;
	SpeedS 25;			AccelS 25, 25;
	SpeedR 15;			AccelR 15, 15;
Fend

Function RELX_Speed
	Power High;
	Speed 1;			Accel 1, 1;
	SpeedS 1;			AccelS 1, 1;
	SpeedR 15;			AccelR 15, 15;
Fend

Function Take_Speed
	Power High;
	SpeedS 1800;		AccelS 10000, 10000;

	If fusible$ = "RELAY_132" Or fusible$ = "RELAY_112" Then
		SpeedS 300;			AccelS 300, 300;
	ElseIf fusible$ = "MAXI_50" Or fusible$ = "MAXI_40" Or fusible$ = "MAXI_30" Then
		SpeedS 320;			AccelS 320, 320;
	EndIf
Fend

Function FastInsertion_Speed
	Power High
	SpeedS 1200;	AccelS 6000, 6000
		
	If fusible$ = "ATO_30" And cavity = 413 Then
		Print("Fusible 30 en 413")
		SpeedS 20;	AccelS 40, 40
	EndIf
	
	If fusible$ = "ATO_30" And cavity = 417 Then
		Print("Fusible 30 en 417")
		SpeedS 20;	AccelS 40, 40
	EndIf
Fend

