Function revisar_vacio3
	
	
	If Sw(vacio_ok) = 0 Then
		Off cilindro
		SubirRobot_Z
		Off vacio
		FindCodo_w
		tomaFusible
		Print "Fusible tomado: " + fusible$
		FindCodo_w
		insertarFusible
	EndIf
	
	
Fend


