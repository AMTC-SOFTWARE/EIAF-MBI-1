    If caja$ = "PDCD" Then
    
    	If cavity >= 222 And cavity <= 226 Then
    	Else
    		ajustY = ajustY + 3.5
	    	If cilindro = cilindro_a Then
	    			ajustY = ajustY - 0.5
	    	EndIf
    	EndIf
    
    	
    EndIf
    
