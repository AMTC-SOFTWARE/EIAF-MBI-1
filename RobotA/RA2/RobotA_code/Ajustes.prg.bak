    If cilindro = cilindro_b Then
		ajustY = ajustY - 0.4
		ajustX = ajustX - 0.4
	EndIf
    
    If caja$ = "PDCD" Then
	    If fusible$ = "MINI_10" Then
	    	If cavity >= 200 And cavity <= 208 Then
