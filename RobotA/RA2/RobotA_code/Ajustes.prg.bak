    	ajustZ = ajustZ + 0
    EndIf
	
	If caja$ = "PDCD" Then
		ajustY = ajustY - 0.7
		ajustX = ajustX - 0.8
	EndIf
	
	
	If cavity = 222 Then
		ajustY = ajustY + 1.5
    	ajustX = ajustX + 2
    EndIf
	
    Print("adjustX: " + Str$(ajustX))
	Print("adjustY: " + Str$(ajustY))
	Print("adjustZ: " + Str$(ajustZ))
	Print("adjustU: " + Str$(ajustU))
	
Fend
